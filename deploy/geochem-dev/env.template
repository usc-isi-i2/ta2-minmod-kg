HOST_UID=1000
HOST_GID=1000
HMI_DIR=/path/to/geochem-hmi
HMI_ENV_FILE=/path/to/hmi.env
# mounted into the containers (data dirs at the same path); keep these off
# root-squashed NFS, which the Docker daemon cannot bind-mount
# config.yml.template with geochem.jsonld_dir/entity_dir set to the dirs below
CFG_FILE=/path/to/geochem-dev-config.yml
GEOCHEM_JSONLD_DIR=/path/to/geochem-jsonld
ENTITY_DIR=/path/to/ta2-minmod-data/data/entities
HMI_DATA_DIR=/path/to/hmi-data
SYNC_DATA_DIR=/path/to/sync-data
POSTGRES_CONTAINER=minmod-kg-postgres-1
FUSEKI_CONTAINER=minmod-kg
