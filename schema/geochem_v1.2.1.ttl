#################################################################
#    Simplified convenience properties extending MinMod classes
#    Defined in geochem namespace to avoid polluting mo: namespace
#################################################################

###  https://geochemistry.isi.edu/ontology/row_index
:row_index rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf mo:mineral_site_dataproperty ;
           rdfs:domain mo:MineralSite ;
           rdfs:range xsd:integer ;
           rdfs:label "row index"@en ;
           rdfs:comment "Row index in source table/spreadsheet"@en .


###  https://geochemistry.isi.edu/ontology/edit_history
:edit_history rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Sample
                                          :Analysis
                                          :Element
                                        )
                          ] ;
              rdfs:range :EditEvent ;
              rdfs:label "edit history"@en ;
              rdfs:comment "Links a Sample/Analysis/Element to one :EditEvent per HMI save that touched it. Additive only, never overwritten or removed, so the full sequence of edits is recoverable by sorting on :updated_at."@en .


###  https://geochemistry.isi.edu/ontology/updated_by
:updated_by rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :EditEvent ;
            rdfs:range xsd:anyURI ;
            rdfs:label "updated by"@en ;
            rdfs:comment "MinMod user URI (e.g. https://minmod.isi.edu/users/u/{username}) of who made this edit."@en .


###  https://geochemistry.isi.edu/ontology/updated_at
:updated_at rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :EditEvent ;
            rdfs:range xsd:dateTime ;
            rdfs:label "updated at"@en ;
            rdfs:comment "Timestamp of this edit."@en .


###  https://geochemistry.isi.edu/ontology/changed_properties
:changed_properties rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :EditEvent ;
                    rdfs:range xsd:anyURI ;
                    rdfs:label "changed properties"@en ;
                    rdfs:comment "URI(s) of the property/properties changed in this edit, e.g. 'https://geochemistry.isi.edu/ontology/grade'. Same convention as mo:property on mo:Reference."@en .


###  https://geochemistry.isi.edu/ontology/is_deleted
:is_deleted rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Sample
                                        :Analysis
                                        :Element
                                        mo:MineralSite
                                      )
                        ] ;
            rdfs:range xsd:boolean ;
            rdfs:label "is deleted"@en ;
            rdfs:comment "Soft-delete flag. The record is never removed -- this marks it as no longer active. Setting it back to false undeletes; there is no separate delete/undelete verb, it's a normal field like any other."@en .


###  https://geochemistry.isi.edu/ontology/deleted_by
:deleted_by rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Sample
                                        :Analysis
                                        :Element
                                        mo:MineralSite
                                      )
                        ] ;
            rdfs:range xsd:anyURI ;
            rdfs:label "deleted by"@en ;
            rdfs:comment "MinMod user URI of who set :is_deleted -- server-derived from the session, never client-supplied, same convention as :EditEvent's :updated_by. A dedicated field rather than reading it off :edit_history: mo:MineralSite has no edit-history mechanism at all (its own mo:created_by is a single overwritten field, by design -- see edit_history_provenance.md's rationale for why that was rejected for per-edit history), so a dedicated field keeps who/when-deleted queryable uniformly across all four classes regardless of which have richer history."@en .


###  https://geochemistry.isi.edu/ontology/deleted_at
:deleted_at rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Sample
                                        :Analysis
                                        :Element
                                        mo:MineralSite
                                      )
                        ] ;
            rdfs:range xsd:dateTime ;
            rdfs:label "deleted at"@en ;
            rdfs:comment "Timestamp :is_deleted was last changed (set on delete, cleared on undelete)."@en .


###  https://geochemistry.isi.edu/ontology/reference
:reference rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf mo:reference ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Sample
                                       :Analysis
                                       :Element
                                       mo:LocationInfo
                                     )
                       ] ;
           rdfs:range mo:Reference ;
           rdfs:label "reference"@en ;
           rdfs:comment "Per-field extraction provenance for a Sample/Analysis/Element value, or per-extraction provenance for a LocationInfo candidate, reusing mo:Reference. Scope to a single field via the existing mo:property; scope to a page/bbox via the existing mo:page_info -> mo:PageInfo -> mo:BoundingBox for PDF sources, or via :artifact_info below for other artifact types. On a LocationInfo, use :candidate_confidence to record how likely this particular extraction is the correct location — a MineralSite may have several LocationInfo extractions (see mo:location_info's relaxed cardinality) that differ only in :candidate_confidence."@en .


###  https://geochemistry.isi.edu/ontology/artifact_info
:artifact_info rdf:type owl:ObjectProperty ;
               rdfs:domain mo:Reference ;
               rdfs:range :ArtifactInfo ;
               rdfs:label "artifact info"@en ;
               rdfs:comment "Structural location of the extracted value within a non-PDF source artifact (Excel, CSV, JSON, ...). For PDF sources, use the existing mo:page_info -> mo:PageInfo -> mo:BoundingBox instead."@en .


###  https://geochemistry.isi.edu/ontology/evidence_quote
:evidence_quote rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain mo:Reference ;
                rdfs:range xsd:string ;
                rdfs:label "evidence quote"@en ;
                rdfs:comment "Verbatim or near-verbatim paper snippet supporting the value this Reference is for."@en .


###  https://geochemistry.isi.edu/ontology/evidence_confidence
:evidence_confidence rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain mo:Reference ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "evidence confidence"@en ;
                     rdfs:comment "Confidence in [0,1] derived from how precisely the value could be anchored to its source (e.g. quote located to a page rectangle, to a page, quote only, asserted with no supporting quote). Distinct from mo:confidence, which scores model/candidate agreement rather than source anchoring."@en .


###  https://geochemistry.isi.edu/ontology/candidate_confidence
:candidate_confidence rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain mo:Reference ;
                      rdfs:range xsd:decimal ;
                      rdfs:label "candidate confidence"@en ;
                      rdfs:comment "Confidence in [0,1] that this candidate (e.g. a LocationInfo extraction reached via :reference) is the correct one among several alternatives. Same kind of judgment as mo:confidence (model/candidate agreement) and mo:CandidateEntity.confidence, but domain-safe on mo:Reference for classes like mo:LocationInfo that mo:reference's domain doesn't cover as a mo:MatchInfo. Distinct from :evidence_confidence, which scores source-anchoring precision, not candidate correctness."@en .


###  https://geochemistry.isi.edu/ontology/extraction_backend
:extraction_backend rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain mo:Reference ;
                    rdfs:range xsd:string ;
                    rdfs:label "extraction backend"@en ;
                    rdfs:comment "Table-extraction backend that produced this measurement (e.g. docling, pdfplumber, camelot)."@en .


###  https://geochemistry.isi.edu/ontology/extraction_confidence
:extraction_confidence rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain mo:Reference ;
                       rdfs:range xsd:decimal ;
                       rdfs:label "extraction confidence"@en ;
                       rdfs:comment "Cross-backend agreement for this measurement in [0,1] (n_backends_agreeing / n_backends_active). Distinct from :evidence_confidence and mo:confidence."@en .


###  https://geochemistry.isi.edu/ontology/paper_id
:paper_id rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain mo:Reference ;
          rdfs:range xsd:string ;
          rdfs:label "paper id"@en ;
          rdfs:comment "Corpus-local paper id (e.g. '2018_Yuan_etal') of the Reference's source document."@en .


###  https://geochemistry.isi.edu/ontology/artifact_path
:artifact_path rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :ArtifactInfo ;
               rdfs:range xsd:string ;
               rdfs:label "artifact path"@en ;
               rdfs:comment "Path/identifier of the source artifact a value was read from, e.g. 'supp:2018_Yuan_etal.xlsx' or 'extract:2018_Yuan_etal.json'."@en .


###  https://geochemistry.isi.edu/ontology/table_id
:table_id rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :TableArtifactInfo ;
          rdfs:range xsd:string ;
          rdfs:label "table id"@en ;
          rdfs:comment "Stable id of the source table a value came from (e.g. 'T1')."@en .


###  https://geochemistry.isi.edu/ontology/table_row
:table_row rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :TableArtifactInfo ;
           rdfs:range xsd:integer ;
           rdfs:label "table row"@en ;
           rdfs:comment "Row index of the source table cell."@en .


###  https://geochemistry.isi.edu/ontology/table_col
:table_col rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :TableArtifactInfo ;
           rdfs:range xsd:integer ;
           rdfs:label "table column"@en ;
           rdfs:comment "Column index of the source table cell."@en .


###  https://geochemistry.isi.edu/ontology/sheet_name
:sheet_name rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :ExcelArtifactInfo ;
            rdfs:range xsd:string ;
            rdfs:label "sheet name"@en ;
            rdfs:comment "Excel sheet name."@en .


###  https://geochemistry.isi.edu/ontology/json_path
:json_path rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :JsonArtifactInfo ;
           rdfs:range xsd:string ;
           rdfs:label "json path"@en ;
           rdfs:comment "JSONPath (or dot-path) locating the extracted field within the source JSON document, e.g. '$.samples[3].analyses[1].grade'."@en .


#################################################################
#    ArtifactInfo class hierarchy
#    Type-scoped location metadata for non-PDF source artifacts,
#    attached to mo:Reference via :artifact_info
#################################################################

###  https://geochemistry.isi.edu/ontology/ArtifactInfo
:ArtifactInfo rdf:type owl:Class ;
              rdfs:label "Artifact Info"@en ;
              rdfs:comment "Abstract base for non-PDF source-artifact location metadata. Always instantiated as one of its subclasses (:ExcelArtifactInfo, :CsvArtifactInfo, :JsonArtifactInfo, ...), never directly."@en .


###  https://geochemistry.isi.edu/ontology/TableArtifactInfo
:TableArtifactInfo rdf:type owl:Class ;
                    rdfs:subClassOf :ArtifactInfo ;
                    rdfs:label "Table Artifact Info"@en ;
                    rdfs:comment "Abstract base for artifacts organized as a row/column table (Excel, CSV, ...). Always instantiated as one of its subclasses, never directly."@en .


###  https://geochemistry.isi.edu/ontology/ExcelArtifactInfo
:ExcelArtifactInfo rdf:type owl:Class ;
                    rdfs:subClassOf :TableArtifactInfo ;
                    rdfs:label "Excel Artifact Info"@en ;
                    rdfs:comment "Location within an Excel workbook: sheet name plus the table cell (via inherited :table_id/:table_row/:table_col)."@en .


###  https://geochemistry.isi.edu/ontology/CsvArtifactInfo
:CsvArtifactInfo rdf:type owl:Class ;
                  rdfs:subClassOf :TableArtifactInfo ;
                  rdfs:label "CSV Artifact Info"@en ;
                  rdfs:comment "Location within a CSV/delimited-text table (via inherited :table_id/:table_row/:table_col)."@en .


###  https://geochemistry.isi.edu/ontology/JsonArtifactInfo
:JsonArtifactInfo rdf:type owl:Class ;
                   rdfs:subClassOf :ArtifactInfo ;
                   rdfs:label "JSON Artifact Info"@en ;
                   rdfs:comment "Location within a JSON document, given as a :json_path."@en .




#################################################################
#    Classes
#################################################################

###  https://geochemistry.isi.edu/ontology/MineralResourcePaper
:MineralResourcePaper rdf:type owl:Class ;
                      rdfs:label "Mineral Resource Paper"@en ;
                      rdfs:comment "A scientific paper or publication containing geochemical data and mineral resource information"@en .


###  https://geochemistry.isi.edu/ontology/Analysis
:Analysis rdf:type owl:Class ;
          rdfs:label "Analysis"@en ;
          rdfs:comment "One lab run/spot. :element is not capped at one (a multi-element panel is a single :Analysis referencing several :Element instances), so the method/instrument/lab fields (:analytical_method, :instrument_type, :laboratory_location, :operating_conditions, :standards_used, :aggregation_method, :data_quality, :analysis_date) are stated once per run here rather than once per element. The per-element measured value lives on :Element instead (:grade/:grade_unit, alongside the pre-existing :detection_limit/:detection_limit_unit), since a single :Analysis can't unambiguously pair multiple scalar grades with multiple elements any other way. Verified against the live KG (2026-08-12): of 822,295 pre-fix per-element :Analysis nodes, these fields were 100% consistent within each of the 55,565 real runs — confirming this was pure duplication, not genuine per-element variation."@en .


###  https://geochemistry.isi.edu/ontology/EditEvent
:EditEvent rdf:type owl:Class ;
           rdfs:label "Edit Event"@en ;
           rdfs:comment "One HMI edit to a :Sample/:Analysis/:Element node: who made it, when, and which properties changed. Append-only: a node accumulates one :EditEvent per save via :edit_history, so the full edit history is preserved rather than overwritten."@en .


###  https://geochemistry.isi.edu/ontology/Element
:Element rdf:type owl:Class ;
         rdfs:label "Element"@en .


###  https://geochemistry.isi.edu/ontology/Isotope
:Isotope rdf:type owl:Class ;
         rdfs:label "Isotope"@en .


###  https://geochemistry.isi.edu/ontology/Sample
:Sample rdf:type owl:Class ;
        rdfs:label "Sample"@en .


###  https://minmod.isi.edu/ontology/BoundingBox
mo:BoundingBox rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty mo:x_max ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:x_min ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:y_max ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:y_min ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:label "Bounding Box"@en .


###  https://minmod.isi.edu/ontology/CandidateEntity
mo:CandidateEntity rdf:type owl:Class ;
                 rdfs:subClassOf mo:MatchInfo ;
                 rdfs:comment "Generic match-candidate wrapper (source, confidence, observed_name, normalized_uri) reused across mo:country, mo:state_or_province, mo:crs, etc. This is what the live MinMod KG actually stores (confirmed via SPARQL against https://minmod.isi.edu/sparql: 3.4M mo:CandidateEntity instances, zero instances of any typed *Candidate subclass). Supersedes mo:CountryCandidate/mo:StateOrProvinceCandidate/mo:CoordinateReferenceSystemCandidate, which were declared in the imported mo: ontology but never adopted by the ETL/API (see minmodkg/models/kg/candidate_entity.py upstream) — dropped from this re-declaration accordingly."@en ;
                 rdfs:label "Candidate Entity"@en .


###  https://minmod.isi.edu/ontology/Commodity
mo:Commodity rdf:type owl:Class ;
           rdfs:subClassOf mo:ThingHasLabel ;
           rdfs:label "Commodity"@en .


###  https://minmod.isi.edu/ontology/CommodityCandidate
mo:CommodityCandidate rdf:type owl:Class ;
                    rdfs:subClassOf mo:MatchInfo ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty mo:normalized_uri ;
                                      owl:allValuesFrom mo:Commodity
                                    ] ;
                    rdfs:label "Commodity Candidate"@en .


###  https://minmod.isi.edu/ontology/CoordinateReferenceSystem
mo:CoordinateReferenceSystem rdf:type owl:Class ;
                           rdfs:subClassOf mo:ThingHasLabel ;
                           rdfs:label "Coordinate Reference System"@en .


###  https://minmod.isi.edu/ontology/Country
mo:Country rdf:type owl:Class ;
         rdfs:subClassOf mo:ThingHasLabel ;
         rdfs:label "Country"@en .


###  https://minmod.isi.edu/ontology/DepositType
mo:DepositType rdf:type owl:Class ;
             rdfs:subClassOf mo:ThingHasLabel ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:environment ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:group ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:label "Deposit Type"@en .


###  https://minmod.isi.edu/ontology/DepositTypeCandidate
mo:DepositTypeCandidate rdf:type owl:Class ;
                      rdfs:subClassOf mo:MatchInfo ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty mo:normalized_uri ;
                                        owl:allValuesFrom mo:DepositType
                                      ] ;
                      rdfs:label "Deposit Type Candidate"@en .


###  https://minmod.isi.edu/ontology/Document
mo:Document rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty mo:description ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:doi ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:issue ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:journal ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:month ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:title ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:uri ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:volume ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:year ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ;
          rdfs:label "Document"@en .


###  https://minmod.isi.edu/ontology/GeologyInfo
mo:GeologyInfo rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty mo:age ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:comments ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:description ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:unit_name ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:label "Geology Info"@en .


###  https://minmod.isi.edu/ontology/LocationInfo
mo:LocationInfo rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty mo:crs ;
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mo:location ;
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:label "Location Info"@en .


###  https://minmod.isi.edu/ontology/MatchInfo
mo:MatchInfo rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty mo:source ;
                             owl:allValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty mo:source ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty mo:normalized_uri ;
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty mo:confidence ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty mo:observed_name ;
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                           ] ;
           rdfs:label "Match Info"@en .


###  https://minmod.isi.edu/ontology/MaterialForm
mo:MaterialForm rdf:type owl:Class ;
              rdfs:subClassOf mo:ThingHasLabel ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mo:commodity ;
                                owl:allValuesFrom mo:Commodity
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mo:commodity ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass mo:Commodity
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty mo:conversion ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:label "Material Form"@en .


###  https://minmod.isi.edu/ontology/MaterialFormCandidate
mo:MaterialFormCandidate rdf:type owl:Class ;
                       rdfs:subClassOf mo:MatchInfo ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty mo:normalized_uri ;
                                         owl:allValuesFrom mo:MaterialForm
                                       ] ;
                       rdfs:label "Material Form Candidate"@en .


###  https://minmod.isi.edu/ontology/Measure
mo:Measure rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty mo:unit ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty mo:value ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:label "Measure"@en .


###  https://minmod.isi.edu/ontology/MineralInventory
mo:MineralInventory rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:commodity ;
                                    owl:allValuesFrom mo:CommodityCandidate
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:commodity ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:contained_metal ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:reference ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:cutoff_grade ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:grade ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:material_form ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:ore ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:date ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty mo:zone ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:label "Mineral Inventory"@en .


###  https://minmod.isi.edu/ontology/MineralSite
mo:MineralSite rdf:type owl:Class ;
             rdfs:subClassOf mo:ThingHasLabel ,
                             mo:ThingMayHaveAltLabel ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:modified_at ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:record_id ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:source_id ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:site_rank ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:site_type ;
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty mo:reference ;
                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:label "Mineral Site"@en .


###  https://minmod.isi.edu/ontology/PageInfo
mo:PageInfo rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty mo:bounding_box ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty mo:page ;
                            owl:cardinality "1"^^xsd:nonNegativeInteger
                          ] ;
          rdfs:label "Page Info"@en .


###  https://minmod.isi.edu/ontology/Reference
mo:Reference rdf:type owl:Class ;
           rdfs:subClassOf mo:ThingMayHaveComment ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty mo:document ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty mo:property ;
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                           ] ;
           rdfs:label "Reference"@en .


###  https://minmod.isi.edu/ontology/ResourceReserveCategory
mo:ResourceReserveCategory rdf:type owl:Class ;
                         rdfs:subClassOf mo:ThingHasLabel ;
                         rdfs:label "Resource Reserve Category"@en .


###  https://minmod.isi.edu/ontology/ResourceReserveCategoryCandidate
mo:ResourceReserveCategoryCandidate rdf:type owl:Class ;
                                  rdfs:subClassOf mo:MatchInfo ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty mo:normalized_uri ;
                                                    owl:allValuesFrom mo:ResourceReserveCategory
                                                  ] ;
                                  rdfs:label "Resource Reserve Category Candidate"@en .


###  https://minmod.isi.edu/ontology/StateOrProvince
mo:StateOrProvince rdf:type owl:Class ;
                 rdfs:subClassOf mo:ThingHasLabel ;
                 rdfs:label "State or Province"@en .


###  https://minmod.isi.edu/ontology/ThingHasLabel
mo:ThingHasLabel rdf:type owl:Class ;
               rdfs:comment "Instance of this class must have rdfs:label"@en ;
               rdfs:label "Thing Has Label"@en .


###  https://minmod.isi.edu/ontology/ThingMayHaveAltLabel
mo:ThingMayHaveAltLabel rdf:type owl:Class ;
                      rdfs:comment "Instance of this class may have aliases defined by skos:altLabel"@en ;
                      rdfs:label "Thing May Have Alt Label"@en .


###  https://minmod.isi.edu/ontology/ThingMayHaveComment
mo:ThingMayHaveComment rdf:type owl:Class ;
                 rdfs:comment "Instance of this class may have rdfs:comment"@en ;
                 rdfs:label "Thing May Have Comment"@en .


###  https://minmod.isi.edu/ontology/Unit
mo:Unit rdf:type owl:Class ;
      rdfs:subClassOf mo:ThingHasLabel ;
      rdfs:label "Unit"@en .


###  https://minmod.isi.edu/ontology/UnitCandidate
mo:UnitCandidate rdf:type owl:Class ;
               rdfs:subClassOf mo:MatchInfo ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty mo:normalized_uri ;
                                 owl:allValuesFrom mo:Unit
                               ] ;
               rdfs:label "Unit Candidate"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( mo:BoundingBox
                mo:Commodity
                mo:CoordinateReferenceSystem
                mo:Country
                mo:DepositType
                mo:Document
                mo:GeologyInfo
                mo:LocationInfo
                mo:MatchInfo
                mo:Measure
                mo:MineralInventory
                mo:MineralSite
                mo:PageInfo
                mo:Reference
                mo:ResourceReserveCategory
                mo:StateOrProvince
                mo:Unit
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( mo:CommodityCandidate
                mo:DepositTypeCandidate
                mo:MaterialFormCandidate
                mo:ResourceReserveCategoryCandidate
                mo:UnitCandidate
              )
] .


###  Generated by merging GeoChemistry and MinMod ontologies
###  Merge strategy: MinMod (full) takes precedence, mos.ttl unique properties added with comments
