DELETE {
    ?s ?p ?o
}
WHERE {
    VALUES ?root { $roots }
    # every site and sample is a root of its own, so don't walk into them
    ?root (!(owl:sameAs|rdf:type|mo:normalized_uri|gco:has_mineral_site|gco:has_sample))* ?s .
    ?s ?p ?o .

    # same-as links are curated separately and outlive a reload
    FILTER (?p != owl:sameAs)
}
